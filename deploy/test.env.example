# EVA – TEST-Werte für `install.sh --test` (P10.T1)
# =============================================================
# Nur für den End-to-End-Lauf auf einem Test-Deploy (LXC/VM). Alle
# Werte hier sind FAKE und klar als Test markiert — der Manager
# startet auch mit unerreichbarem HA (Robustheitstests P9.T5).
#
# KRITISCH für die mDNS-Isolation: MANAGER_MDNS_ENABLED=false —
# der Test-Deploy darf den echten Dot NICHT vom Produktions-Manager
# stehlen (mDNS `_emcontroller._tcp`).
HA_BASE_URL=http://127.0.0.1:8123
HA_TOKEN=FAKE-HA-TOKEN-TEST-DEPLOY-NICHT-ECHT
LLM_API_KEY=FAKE-LLM-KEY-TEST-DEPLOY-NICHT-ECHT
MANAGER_MDNS_ENABLED=false
