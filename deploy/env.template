# EVA – `.env`-Vorlage (P10.T1)
# =============================================================
# ERZEUGUNG: Diese Datei wird NIE direkt benutzt. `deploy/install.sh`
# rendert daraus eine echte `.env` im Zielverzeichnis (Default
# /opt/eva/.env, chmod 600). Der Onboarding-Wizard (P10.T2) fragt die
# Pflichtfelder ab; bis dahin gibt `install.sh --test` Testwerte.
#
# KEINE SECRETS IN DIESEM REPO: Platzhalter unten bleiben leer; echte
# Werte landen nur in der gerenderten `.env` am Zielhost.
#
# Key-Liste 1:1 aus `app/config.py` (Quelle der Defaults) und
# (Bedeutung/Klassifizierung siehe `app/config.py`).
# Wizard-Pflicht: HA_TOKEN, LLM_API_KEY, HA_BASE_URL.
# Abgeleitet (vom Installer/Wrapper gesetzt, je Topologie):
#   WHISPER_HOST, PIPER_HOST (single-host = 127.0.0.1).
#
# Die Vorlage
# deckt ALLE Felder aus
# `app/config.py` ab.

# ── Block 1: Manager / WebSocket ──────────────────────────────────
MANAGER_HOST=0.0.0.0
MANAGER_PORT=8767
# mDNS-Instance-Name. NICHT ändern: der Dot filtert darauf (P10.T3).
MANAGER_MDNS_NAME=echomuse
# mDNS-Announcement `_emcontroller._tcp.local` an/aus.
# ACHTUNG: In einem Netz mit laufendem Produktions-Manager AUF `false`
# setzen (z. B. Test-Deploy), sonst kann der Dot zur zweiten Instanz
# wechseln (allow_name_change ⇒ echomuse-2).
MANAGER_MDNS_ENABLED=true
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=30

# ── Block 2: Wake-Word (openWakeWord, manager-seitig) ─────────────
OWW_ENABLED=true
OWW_MODEL=hey_jarvis_v0.1
# E104-Default aus den Messdaten (P9.T1, datenbasiert 0,9 → 0,80).
OWW_THRESHOLD=0.80
OWW_BARGE_IN_ENABLED=true
OWW_BARGE_IN_THRESHOLD=0.15
OWW_SPEEX_NS=true
OWW_CHUNK_BYTES=2560
OWW_WARMUP_CHUNKS=16
OWW_PREROLL_DISCARD_CHUNKS=3
OWW_COOLDOWN_MS=1000
OWW_SCORE_EVERY_N_CHUNKS=1

# ── Block 3: Turn-Steuerung ───────────────────────────────────────
TURN_HARD_CAP_SECONDS=15
TURN_NO_SPEECH_SECONDS=8
VAD_DEVICE_SIDED=true
MIC_START_LOCK_MIC_BUTTON=true

# ── Block 4: STT – Whisper (Wyoming) ──────────────────────────────
# ABIgeleitet: single-host = 127.0.0.1, verteilt = IP des STT-Hosts.
WHISPER_HOST=127.0.0.1
WHISPER_PORT=10300
WHISPER_LANGUAGE=de
# Nur informatorisch: das WIRKSAME Modell steht als `--model`-Arg im
# Whisper-Container (siehe compose/docker-compose.yml.tmpl). Der
# Manager steuert es nicht.
WHISPER_MODEL=small

# ── Block 5: TTS – Piper (Wyoming) ────────────────────────────────
# Abgeleitet: single-host = 127.0.0.1, verteilt = IP des TTS-Hosts.
PIPER_HOST=127.0.0.1
PIPER_PORT=10200
PIPER_VOICE=de_DE-thorsten-high

# ── Block 6: Audio ────────────────────────────────────────────────
AUDIO_MIC_RATE=16000
AUDIO_SPEAKER_RATE=48000
AUDIO_WIDTH=2
AUDIO_CHANNELS=1
SPEAKER_CHUNK_BYTES=4096

# ── Block 7: Home Assistant ───────────────────────────────────────
# WIZARD-PFLICHT (Default ist host-gebunden und in einem generischen
# Deploy falsch): Basis-URL deiner HA-Instanz, z. B. http://<ha-ip>:8123
HA_BASE_URL=
# WIZARD-PFLICHT / SECRET: HA Long-Lived Access Token (~180 Zeichen),
# Bearer für GET /api/states + POST /api/services/...  Nie ins Git!
HA_TOKEN=
# E113 (P12.T2): 16 steuerfähige Domains = die 14 sicheren Schalt-Domains
# plus `update` (27) und `automation` (47) – live 209 -> 375 Entities.
# Sicherheits-/Hochrisiko-Domains (`lock`, `alarm_control_panel`, `vacuum`)
# sind **kein** Env-Key: sie stehen hart in `HA_BLOCKED_DOMAINS`
# (`app/ha_client.py`) und sind über diese Liste **nicht** freischaltbar.
# Read-only-Domains (`sensor`, `binary_sensor`, `device_tracker`, `weather`,
# `person`, `zone`, `sun`, `event`) bleiben draußen.
HA_ENTITY_DOMAINS=light,switch,cover,climate,media_player,scene,script,button,number,select,input_boolean,input_select,input_number,fan,update,automation
HA_CACHE_INTERVAL_SECONDS=600
HA_REQUEST_TIMEOUT=5.0
# Statische Entity-Allowlist, kommagetrennt; leer = kein Vorfilter.
HA_ALLOWED_ENTITIES=

# ── Block 8: LLM-Gateway (opencode.ai) ────────────────────────────
LLM_BASE_URL=https://opencode.ai/zen/v1
# WIZARD-PFLICHT / SECRET: Bearer-Key (~51 Zeichen) für Jev + DeepSeek.
LLM_API_KEY=
JEV_MODE=intent
JEV_MODEL=jev-1.13
JEV_TIMEOUT=8.0
DEEPSEEK_MODEL=deepseek-v4.1-flash
DEEPSEEK_BASE_URL=https://opencode.ai/zen/v1/chat/completions
DEEPSEEK_TIMEOUT=12.0
DEEPSEEK_SYSTEM_PROMPT=Du bist ein hilfreicher Assistent. Antworte kurz und präzise, auf Deutsch.
# COMMAND wird darunter abgelehnt (E3).
ROUTER_CONFIDENCE_GATE=0.75
# class = Variante A (Default) | entity = Variante D (2-stufiges Jev).
ROUTER_VARIANT=class
ROUTER_NEEDS_PARAM_THRESHOLD=0.5

# ── Block 9: Logging / Dashboard / Diagnostik / Test ──────────────
LOG_LEVEL=INFO
# Dashboard-Schreibmodus (eine Route), bewusst AUS (E96).
DASHBOARD_WRITE_ENABLED=false
# Optionale Auth für POST /api/config/* (E110). LEER = offen (Default);
# gesetzt ⇒ Bearer-Token Pflicht. Secret: Wert nur in der gerenderten .env.
DASHBOARD_API_TOKEN=
# Wake-Messring-Boden (E96).
WAKE_ATTEMPT_KEEP_FLOOR=0.2
# Audio-Diagnose-Dump; Produkt-Default AUS. Dumps enthalten rohe
# Sprache und überleben kein Container-Recreate.
AUDIO_DUMP_ENABLED=false
AUDIO_DUMP_DIR=/tmp/audio-dumps
AUDIO_DUMP_MAX_FILES=50
AUDIO_DUMP_MAX_BYTES=104857600
# /internal/* existiert sonst nicht (404). Produktions-Deploy: false.
ENABLE_TEST_HOOKS=false
RUN_LIVE=0
TEST_MANAGER_PORT=18767
