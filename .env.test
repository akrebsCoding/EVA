# EVA – Testkonfiguration für lokale Testläufe (P9.T0, PLAN.md:538).
#
# **Nur Platzhalter, keine echten Secrets.** Die Werte werden vom L2-Harness
# (`tests/conftest.py` → `manager_proc`) als Umgebungsvariablen an den
# Manager-Subprozess übergeben und überschreiben damit die echte `.env`
# (pydantic-settings: OS-Env > Dotenv-Datei). Die echte `.env` bleibt
# unberührt.
#
# Zweck: der Manager läuft isoliert auf `.22` gegen **Fake-Endpunkte**, ohne
# echten HA/LLM/Piper/Whisper, ohne mDNS, mit eigenem Port und nur für L2/L5a
# freigeschalteten `/internal/*`-Test-Hooks.
#
# Hinweis: `.gitignore:5` ignoriert `.env.test` – bewusst so belassen
# (Env-Dateien bleiben aus dem Repo; es sind ohnehin keine Secrets enthalten).

# ── Manager / WebSocket ────────────────────────────────────────────
MANAGER_HOST=127.0.0.1
MANAGER_PORT=18767
MANAGER_MDNS_NAME=echomuse-test
MANAGER_MDNS_ENABLED=false
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=30

# ── Wake-Word ──────────────────────────────────────────────────────
OWW_ENABLED=true
OWW_MODEL=hey_jarvis_v0.1
OWW_THRESHOLD=0.9
OWW_BARGE_IN_ENABLED=true
OWW_BARGE_IN_THRESHOLD=0.15
OWW_SPEEX_NS=true
OWW_CHUNK_BYTES=2560
OWW_WARMUP_CHUNKS=16
OWW_PREROLL_DISCARD_CHUNKS=3
OWW_COOLDOWN_MS=1000
OWW_SCORE_EVERY_N_CHUNKS=1

# ── Turn-Steuerung ─────────────────────────────────────────────────
TURN_HARD_CAP_SECONDS=15
TURN_NO_SPEECH_SECONDS=8
VAD_DEVICE_SIDED=true
MIC_START_LOCK_MIC_BUTTON=true

# ── STT/TTS – Fake-Wyoming (P9.T2) ─────────────────────────────────
WHISPER_HOST=127.0.0.1
WHISPER_PORT=10300
WHISPER_LANGUAGE=de
WHISPER_MODEL=base
PIPER_HOST=127.0.0.1
PIPER_PORT=10200
PIPER_VOICE=de_DE-thorsten-high

# ── Audio ──────────────────────────────────────────────────────────
AUDIO_MIC_RATE=16000
AUDIO_SPEAKER_RATE=48000
AUDIO_WIDTH=2
AUDIO_CHANNELS=1
SPEAKER_CHUNK_BYTES=4096

# ── Fake-Endpunkte (nichts lauscht auf :9 ⇒ sofortige Connection refused) ──
HA_BASE_URL=http://127.0.0.1:9
HA_TOKEN=test-ha-token-placeholder
# E113 (P12.T2): hier bewusst die **alten 7** Domains – der L2-Manager
# (`tests/conftest.py::manager_proc`) soll deterministisch bleiben. Der
# Produktiv-Default (16 Domains) wird von `tests/test_ha_client.py::
# test_env_template_matches_config_default` gegen `app/config.py` geprüft,
# nicht durch diese Test-Datei.
HA_ENTITY_DOMAINS=light,switch,cover,climate,media_player,scene,script
HA_CACHE_INTERVAL_SECONDS=600
HA_REQUEST_TIMEOUT=1.0
HA_ALLOWED_ENTITIES=

LLM_BASE_URL=http://127.0.0.1:9
LLM_API_KEY=test-llm-key-placeholder
JEV_MODE=intent
JEV_MODEL=jev-1.13
JEV_TIMEOUT=2.0
DEEPSEEK_MODEL=deepseek-v4.1-flash
DEEPSEEK_BASE_URL=http://127.0.0.1:9
DEEPSEEK_TIMEOUT=2.0
ROUTER_CONFIDENCE_GATE=0.75

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Test-Hooks (nur L2/L5a) ────────────────────────────────────────
ENABLE_TEST_HOOKS=true
RUN_LIVE=0
TEST_MANAGER_PORT=18767
