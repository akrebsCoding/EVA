# EVA – `.env`-Vorlage
# Kopieren:  cp .env.example .env  (chmod 600, nie ins Git!)
# Secrets (HA_TOKEN, LLM_API_KEY) bleiben LEER und werden vom User gesetzt.

# ── Manager / WebSocket ────────────────────────────────────────────
MANAGER_HOST=0.0.0.0
MANAGER_PORT=8767
MANAGER_MDNS_NAME=echomuse
MANAGER_MDNS_ENABLED=true
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=30

# ── Wake-Word (openWakeWord, manager-seitig) ───────────────────────
OWW_ENABLED=true
OWW_MODEL=hey_jarvis_v0.1
OWW_THRESHOLD=0.9
OWW_BARGE_IN_ENABLED=true
OWW_BARGE_IN_THRESHOLD=0.15
OWW_SPEEX_NS=true                   # → enable_speex_noise_suppression
OWW_CHUNK_BYTES=2560                # 80 ms @ 16 kHz S16_LE
OWW_WARMUP_CHUNKS=16                # Treffer nach model.reset() verwerfen
OWW_PREROLL_DISCARD_CHUNKS=3        # 240 ms Audio-Anfang verwerfen
OWW_COOLDOWN_MS=1000                # Nachsorge gegen Geister-Wakes
OWW_SCORE_EVERY_N_CHUNKS=1          # CPU-Regler

# ── Turn-Steuerung ─────────────────────────────────────────────────
TURN_HARD_CAP_SECONDS=15            # Sicherheitsnetz
TURN_NO_SPEECH_SECONDS=8            # Sicherheitsnetz
VAD_DEVICE_SIDED=true               # Turn-Ende kommt vom Gerät (0x04/0x05)
MIC_START_LOCK_MIC_BUTTON=true      # Button-Pfad: Beamformer aufs Sprechermikro

# ── STT – Whisper (Wyoming, im selben Compose) ─────────────────────
WHISPER_HOST=127.0.0.1
WHISPER_PORT=10300
WHISPER_LANGUAGE=de
WHISPER_MODEL=base                  # base int8 | small | tiny

# ── TTS – Piper (Wyoming, im selben Compose) ───────────────────────
PIPER_HOST=127.0.0.1
PIPER_PORT=10200
PIPER_VOICE=de_DE-thorsten-high

# ── Audio ──────────────────────────────────────────────────────────
AUDIO_MIC_RATE=16000
AUDIO_SPEAKER_RATE=48000
AUDIO_WIDTH=2
AUDIO_CHANNELS=1
SPEAKER_CHUNK_BYTES=4096

# ── Home Assistant ─────────────────────────────────────────────────
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=                           # Long-Lived Access Token aus Home Assistant
# 16 steuerfähige Domains (14 sichere + update + automation).
# `lock`/`alarm_control_panel`/`vacuum` sind hart in `HA_BLOCKED_DOMAINS`
# blockiert und hier nicht freischaltbar; Read-only-Domains bleiben draußen.
HA_ENTITY_DOMAINS=light,switch,cover,climate,media_player,scene,script,button,number,select,input_boolean,input_select,input_number,fan,update,automation
HA_CACHE_INTERVAL_SECONDS=600
HA_REQUEST_TIMEOUT=5.0
HA_ALLOWED_ENTITIES=                # statische Allowlist, leer = nur Domain-Filter

# ── LLM-Gateway ────────────────────────────────────────────────────
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=                        # oc_sk_… – in .env, nie in Git
JEV_MODE=intent                     # intent | gate | off
JEV_MODEL=jev-1.13
JEV_TIMEOUT=8.0
DEEPSEEK_MODEL=deepseek-v4.1-flash
DEEPSEEK_BASE_URL=https://opencode.ai/zen/v1/chat/completions
DEEPSEEK_TIMEOUT=12.0
DEEPSEEK_SYSTEM_PROMPT=Du bist ein hilfreicher Assistent. Antworte kurz und präzise, auf Deutsch.
ROUTER_CONFIDENCE_GATE=0.75
ROUTER_VARIANT=class                # class (Default) | entity (2-stufiges Jev)
ROUTER_NEEDS_PARAM_THRESHOLD=0.5    # Schwelle „muss ein Zahlenwert angegeben werden?“

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Test-Hooks (nur Testbetrieb) ───────────────────────────────────
ENABLE_TEST_HOOKS=false             # true nur für Testläufe; /internal/* ist sonst 404
RUN_LIVE=0                          # 1 = Live-Tests gegen das echte Deployment freischalten
TEST_MANAGER_PORT=18767             # Manager-Port für lokale Testläufe
